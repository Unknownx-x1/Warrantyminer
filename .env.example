# WarrantyPatternMiner Environment Configuration

# Database
DATABASE_URL=sqlite:///./warranty_miner.db

# Ollama Local LLM (Set USE_OLLAMA=true when you have an active ollama instance running)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI & LLM Providers (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Statistical & Clustering Parameters
MIN_CLUSTER_SIZE=4
MIN_SAMPLES=2
ALERT_SCORE_THRESHOLD=60.0
CRITICAL_SCORE_THRESHOLD=80.0
SIGNIFICANCE_Z_THRESHOLD=2.0
